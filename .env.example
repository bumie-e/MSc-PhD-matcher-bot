# Supabase
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Groq (project owner key). Only the shared search agent uses it, to structure
# scraped listings into the common opportunities pool. Personalised work (CV
# reading, match scoring) runs on each user's OWN key, saved encrypted via the
# save-llm-key Edge Function and decrypted with COOKIE_ENCRYPTION_KEY below.
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Optional: local synthetic checks (python -m agents.check_llm).
# These do not replace the encrypted keys saved through Settings.
GEMINI_API_KEY=
DEEPSEEK_API_KEY=

# Search
TAVILY_API_KEY=

# Encrypts users' AI keys (AES-256 key, 32 raw bytes, base64-encoded)
# generate with: openssl rand -base64 32
COOKIE_ENCRYPTION_KEY=
